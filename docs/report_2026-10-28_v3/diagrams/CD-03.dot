digraph G {
graph [bgcolor="white",rankdir=LR,nodesep=0.35,ranksep=0.85,pad=0.15,splines=polyline];
node [fontname="Times New Roman", fontsize=17, color="black", fontcolor="black", style="filled", fillcolor="white", penwidth=1.1];
edge [fontname="Times New Roman", fontsize=14, color="black", arrowsize=0.7, penwidth=0.9];
Room [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>Room</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">status: RoomStatus</TD></TR><TR><TD ALIGN="LEFT">propertyId: String</TD></TR><TR><TD ALIGN="LEFT">name: String</TD></TR><TR><TD ALIGN="LEFT">floor: Int?</TD></TR></TABLE>>];
RoomListing [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>RoomListing</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">roomId: String</TD></TR><TR><TD ALIGN="LEFT">status: ListingStatus</TD></TR><TR><TD ALIGN="LEFT">version: Int</TD></TR><TR><TD ALIGN="LEFT">viewingSlotsRequired: Boolean</TD></TR></TABLE>>];
SavedListing [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>SavedListing</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">userId: String</TD></TR><TR><TD ALIGN="LEFT">listingId: String</TD></TR><TR><TD ALIGN="LEFT">createdAt: DateTime</TD></TR></TABLE>>];
RoomViewing [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>RoomViewing</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">landlordId: String</TD></TR><TR><TD ALIGN="LEFT">leaseId: String?</TD></TR><TR><TD ALIGN="LEFT">status: ViewingStatus</TD></TR><TR><TD ALIGN="LEFT">version: Int</TD></TR></TABLE>>];
ViewingSlot [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>ViewingSlot</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">listingId: String</TD></TR><TR><TD ALIGN="LEFT">startsAt: DateTime</TD></TR><TR><TD ALIGN="LEFT">endsAt: DateTime</TD></TR><TR><TD ALIGN="LEFT">createdAt: DateTime</TD></TR></TABLE>>];
SavedSearch [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>SavedSearch</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">userId: String</TD></TR><TR><TD ALIGN="LEFT">name: String</TD></TR><TR><TD ALIGN="LEFT">filters: Json</TD></TR><TR><TD ALIGN="LEFT">enabled: Boolean</TD></TR></TABLE>>];
SavedSearchMatch [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>SavedSearchMatch</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">savedSearchId: String</TD></TR><TR><TD ALIGN="LEFT">listingId: String</TD></TR><TR><TD ALIGN="LEFT">readAt: DateTime?</TD></TR><TR><TD ALIGN="LEFT">createdAt: DateTime</TD></TR></TABLE>>];
ListingReport [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>ListingReport</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">status: String</TD></TR><TR><TD ALIGN="LEFT">version: Int</TD></TR><TR><TD ALIGN="LEFT">listingId: String</TD></TR><TR><TD ALIGN="LEFT">reporterId: String</TD></TR></TABLE>>];
RoomListing -> Room [dir=none,label="room",taillabel="0..1",headlabel="1",labeldistance=2.1];
SavedListing -> RoomListing [dir=none,label="listing",taillabel="0..*",headlabel="1",labeldistance=2.1];
RoomViewing -> ViewingSlot [dir=none,label="slot",taillabel="0..*",headlabel="0..1",labeldistance=2.1];
RoomViewing -> RoomListing [dir=none,label="listing",taillabel="0..*",headlabel="1",labeldistance=2.1];
ViewingSlot -> RoomListing [dir=none,label="listing",taillabel="0..*",headlabel="1",labeldistance=2.1];
SavedSearchMatch -> SavedSearch [dir=none,label="search",taillabel="0..*",headlabel="1",labeldistance=2.1];
SavedSearchMatch -> RoomListing [dir=none,label="listing",taillabel="0..*",headlabel="1",labeldistance=2.1];
ListingReport -> RoomListing [dir=none,label="listing",taillabel="0..*",headlabel="1",labeldistance=2.1];
}
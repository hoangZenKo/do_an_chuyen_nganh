digraph G {
graph [bgcolor="white",rankdir=LR,nodesep=0.35,ranksep=0.85,pad=0.15,splines=polyline];
node [fontname="Times New Roman", fontsize=17, color="black", fontcolor="black", style="filled", fillcolor="white", penwidth=1.1];
edge [fontname="Times New Roman", fontsize=14, color="black", arrowsize=0.7, penwidth=0.9];
User [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>User</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">sessionVersion: Int</TD></TR><TR><TD ALIGN="LEFT">fullName: String</TD></TR><TR><TD ALIGN="LEFT">email: String</TD></TR><TR><TD ALIGN="LEFT">phone: String?</TD></TR></TABLE>>];
ModerationWorkItem [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>ModerationWorkItem</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">version: Int</TD></TR><TR><TD ALIGN="LEFT">escalatedAt: DateTime?</TD></TR><TR><TD ALIGN="LEFT">kind: String</TD></TR><TR><TD ALIGN="LEFT">targetId: String</TD></TR></TABLE>>];
ModerationDecision [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>ModerationDecision</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">version: Int</TD></TR><TR><TD ALIGN="LEFT">evidence: Json?</TD></TR><TR><TD ALIGN="LEFT">policyId: String?</TD></TR><TR><TD ALIGN="LEFT">kind: String</TD></TR></TABLE>>];
ModerationAppeal [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>ModerationAppeal</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">status: String</TD></TR><TR><TD ALIGN="LEFT">version: Int</TD></TR><TR><TD ALIGN="LEFT">decisionId: String</TD></TR><TR><TD ALIGN="LEFT">requesterId: String</TD></TR></TABLE>>];
ModerationQualityReview [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>ModerationQualityReview</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">decisionId: String</TD></TR><TR><TD ALIGN="LEFT">reviewerId: String</TD></TR><TR><TD ALIGN="LEFT">outcome: String</TD></TR><TR><TD ALIGN="LEFT">reason: String</TD></TR></TABLE>>];
FinanceStatement [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>FinanceStatement</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">propertyId: String</TD></TR><TR><TD ALIGN="LEFT">accountKey: String</TD></TR><TR><TD ALIGN="LEFT">importKey: String</TD></TR><TR><TD ALIGN="LEFT">contentHash: String</TD></TR></TABLE>>];
FinanceStatementLine [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>FinanceStatementLine</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">receiptId: String?</TD></TR><TR><TD ALIGN="LEFT">status: String</TD></TR><TR><TD ALIGN="LEFT">amount: Int</TD></TR><TR><TD ALIGN="LEFT">version: Int</TD></TR></TABLE>>];
FinanceReconciliationProposal [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>FinanceReconciliationProposal</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">receiptId: String?</TD></TR><TR><TD ALIGN="LEFT">status: String</TD></TR><TR><TD ALIGN="LEFT">lineId: String</TD></TR><TR><TD ALIGN="LEFT">paymentId: String?</TD></TR></TABLE>>];
ModerationQualityReview -> ModerationDecision [dir=none,label="decision",taillabel="0..1",headlabel="1",labeldistance=2.1];
ModerationAppeal -> ModerationDecision [dir=none,label="decision",taillabel="0..*",headlabel="1",labeldistance=2.1];
ModerationAppeal -> User [dir=none,label="requester",taillabel="0..*",headlabel="1",labeldistance=2.1];
FinanceStatementLine -> FinanceStatement [dir=none,label="statement",taillabel="0..*",headlabel="1",labeldistance=2.1];
FinanceReconciliationProposal -> FinanceStatementLine [dir=none,label="line",taillabel="0..*",headlabel="1",labeldistance=2.1];
}
digraph G {
graph [bgcolor="white",rankdir=LR,nodesep=0.35,ranksep=0.85,pad=0.15,splines=polyline];
node [fontname="Times New Roman", fontsize=17, color="black", fontcolor="black", style="filled", fillcolor="white", penwidth=1.1];
edge [fontname="Times New Roman", fontsize=14, color="black", arrowsize=0.7, penwidth=0.9];
User [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>User</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">sessionVersion: Int</TD></TR><TR><TD ALIGN="LEFT">fullName: String</TD></TR><TR><TD ALIGN="LEFT">email: String</TD></TR><TR><TD ALIGN="LEFT">phone: String?</TD></TR></TABLE>>];
Announcement [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>Announcement</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">landlordId: String</TD></TR><TR><TD ALIGN="LEFT">roomId: String?</TD></TR><TR><TD ALIGN="LEFT">status: AnnouncementStatus</TD></TR><TR><TD ALIGN="LEFT">propertyId: String?</TD></TR></TABLE>>];
AnnouncementRecipient [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>AnnouncementRecipient</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">tenantId: String</TD></TR><TR><TD ALIGN="LEFT">announcementId: String</TD></TR><TR><TD ALIGN="LEFT">readAt: DateTime?</TD></TR></TABLE>>];
TenantNotificationPreference [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>TenantNotificationPreference</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">tenantId: String</TD></TR><TR><TD ALIGN="LEFT">channels: String[]</TD></TR><TR><TD ALIGN="LEFT">enabled: Boolean</TD></TR><TR><TD ALIGN="LEFT">createdAt: DateTime</TD></TR></TABLE>>];
NotificationDelivery [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>NotificationDelivery</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">landlordId: String</TD></TR><TR><TD ALIGN="LEFT">tenantId: String?</TD></TR><TR><TD ALIGN="LEFT">invoiceId: String?</TD></TR><TR><TD ALIGN="LEFT">status: NotificationDeliveryStatus</TD></TR></TABLE>>];
BillingReminderPolicy [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>BillingReminderPolicy</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">landlordId: String</TD></TR><TR><TD ALIGN="LEFT">version: Int</TD></TR><TR><TD ALIGN="LEFT">scopeKey: String</TD></TR><TR><TD ALIGN="LEFT">propertyId: String?</TD></TR></TABLE>>];
BillingOutboxEvent [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>BillingOutboxEvent</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">landlordId: String</TD></TR><TR><TD ALIGN="LEFT">status: String</TD></TR><TR><TD ALIGN="LEFT">eventKey: String</TD></TR><TR><TD ALIGN="LEFT">type: String</TD></TR></TABLE>>];
BillingNotification [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>BillingNotification</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">tenantId: String</TD></TR><TR><TD ALIGN="LEFT">invoiceId: String</TD></TR><TR><TD ALIGN="LEFT">eventKey: String</TD></TR><TR><TD ALIGN="LEFT">title: String</TD></TR></TABLE>>];
BillingReminderPolicy -> User [dir=none,label="landlord",taillabel="0..*",headlabel="1",labeldistance=2.1];
BillingOutboxEvent -> User [dir=none,label="landlord",taillabel="0..*",headlabel="1",labeldistance=2.1];
Announcement -> User [dir=none,label="landlord",taillabel="0..*",headlabel="1",labeldistance=2.1];
AnnouncementRecipient -> Announcement [dir=none,label="announcement",taillabel="0..*",headlabel="1",labeldistance=2.1];
}
u4 [shape=ellipse,label="UC-TNT-02.4\nXóa hồ sơ chưa có lịch sử\nnghiệp vụ",margin="0.12,0.08"];
u5 [shape=ellipse,label="UC-TNT-03\nMời người thuê truy cập cổng\nthông tin",margin="0.12,0.08"];
u6 [shape=ellipse,label="UC-TNT-04\nTra cứu hợp đồng và cảnh báo\nhết hạn",margin="0.12,0.08"];
}
actor0 -> u0 [arrowhead=none];
actor1 -> u0 [arrowhead=none];

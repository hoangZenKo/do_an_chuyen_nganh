u4 [shape=ellipse,label="UC-BIL-17.2\nChạy trước và thực hiện đợt\nlập hóa đơn",margin="0.12,0.08"];
u5 [shape=ellipse,label="UC-BIL-18\nCấu hình nhắc nợ và theo dõi\noutbox",margin="0.12,0.08"];
u6 [shape=ellipse,label="UC-BIL-19\nQuản lý khoản chi vận hành",margin="0.12,0.08"];
}
actor0 -> u0 [arrowhead=none];
actor1 -> u0 [arrowhead=none];

actor1 [shape=box,label="«actor»\nStaff đúng quyền/scope"];
subgraph cluster_system { label="Rental Room Management · Hóa đơn và sổ thu chi";fontname="Times New Roman";fontsize=18;color="black";
u0 [shape=ellipse,label="UC-BIL-14\nDuyệt hoặc từ chối chứng từ\nthanh toán",margin="0.12,0.08"];

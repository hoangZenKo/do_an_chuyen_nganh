digraph G {
graph [bgcolor="white",rankdir=LR,nodesep=0.35,ranksep=0.85,pad=0.15,splines=polyline];
node [fontname="Times New Roman", fontsize=17, color="black", fontcolor="black", style="filled", fillcolor="white", penwidth=1.1];
edge [fontname="Times New Roman", fontsize=14, color="black", arrowsize=0.7, penwidth=0.9];
User [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>User</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">sessionVersion: Int</TD></TR><TR><TD ALIGN="LEFT">fullName: String</TD></TR><TR><TD ALIGN="LEFT">email: String</TD></TR><TR><TD ALIGN="LEFT">phone: String?</TD></TR></TABLE>>];
AuditLog [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>AuditLog</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">landlordId: String?</TD></TR><TR><TD ALIGN="LEFT">actorId: String?</TD></TR><TR><TD ALIGN="LEFT">actorRole: UserRole</TD></TR><TR><TD ALIGN="LEFT">action: String</TD></TR></TABLE>>];
AdminStepUpGrant [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>AdminStepUpGrant</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">userId: String</TD></TR><TR><TD ALIGN="LEFT">tokenHash: String</TD></TR><TR><TD ALIGN="LEFT">sessionId: String</TD></TR><TR><TD ALIGN="LEFT">action: String</TD></TR></TABLE>>];
DeliveryJob [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>DeliveryJob</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">status: String</TD></TR><TR><TD ALIGN="LEFT">kind: String</TD></TR><TR><TD ALIGN="LEFT">tokenId: String?</TD></TR><TR><TD ALIGN="LEFT">payload: String?</TD></TR></TABLE>>];
AdminTeam [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>AdminTeam</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">version: Int</TD></TR><TR><TD ALIGN="LEFT">name: String</TD></TR><TR><TD ALIGN="LEFT">description: String</TD></TR><TR><TD ALIGN="LEFT">isActive: Boolean</TD></TR></TABLE>>];
AdminTeamMember [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>AdminTeamMember</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">userId: String</TD></TR><TR><TD ALIGN="LEFT">teamId: String</TD></TR><TR><TD ALIGN="LEFT">role: String</TD></TR><TR><TD ALIGN="LEFT">createdAt: DateTime</TD></TR></TABLE>>];
FeatureFlag [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>FeatureFlag</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">version: Int</TD></TR><TR><TD ALIGN="LEFT">key: String</TD></TR><TR><TD ALIGN="LEFT">enabled: Boolean</TD></TR><TR><TD ALIGN="LEFT">rollout: Int</TD></TR><TR><TD ALIGN="LEFT">roles: String[]</TD></TR></TABLE>>];
AuditLog -> User [dir=none,label="landlord",taillabel="0..*",headlabel="0..1",labeldistance=2.1];
AuditLog -> User [dir=none,label="actor",taillabel="0..*",headlabel="0..1",labeldistance=2.1];
AdminTeamMember -> AdminTeam [dir=none,label="team",taillabel="0..*",headlabel="1",labeldistance=2.1];
AdminTeamMember -> User [dir=none,label="user",taillabel="0..*",headlabel="1",labeldistance=2.1];
}
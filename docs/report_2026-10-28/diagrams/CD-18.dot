digraph G {
graph [bgcolor="white",rankdir=LR,nodesep=0.35,ranksep=0.85,pad=0.15,splines=polyline];
node [fontname="Times New Roman", fontsize=17, color="black", fontcolor="black", style="filled", fillcolor="white", penwidth=1.1];
edge [fontname="Times New Roman", fontsize=14, color="black", arrowsize=0.7, penwidth=0.9];
User [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>User</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">sessionVersion: Int</TD></TR><TR><TD ALIGN="LEFT">fullName: String</TD></TR><TR><TD ALIGN="LEFT">email: String</TD></TR><TR><TD ALIGN="LEFT">phone: String?</TD></TR></TABLE>>];
Property [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>Property</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">landlordId: String</TD></TR><TR><TD ALIGN="LEFT">name: String</TD></TR><TR><TD ALIGN="LEFT">address: String</TD></TR><TR><TD ALIGN="LEFT">isArchived: Boolean</TD></TR></TABLE>>];
LandlordVerification [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>LandlordVerification</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">landlordId: String</TD></TR><TR><TD ALIGN="LEFT">status: String</TD></TR><TR><TD ALIGN="LEFT">version: Int</TD></TR><TR><TD ALIGN="LEFT">ticketId: String</TD></TR></TABLE>>];
PropertyApprovalReview [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>PropertyApprovalReview</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">status: String</TD></TR><TR><TD ALIGN="LEFT">version: Int</TD></TR><TR><TD ALIGN="LEFT">propertyId: String</TD></TR><TR><TD ALIGN="LEFT">snapshotHash: String</TD></TR></TABLE>>];
ServicePlan [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>ServicePlan</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">version: Int</TD></TR><TR><TD ALIGN="LEFT">code: String</TD></TR><TR><TD ALIGN="LEFT">name: String</TD></TR><TR><TD ALIGN="LEFT">price: Int</TD></TR></TABLE>>];
LandlordSubscription [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>LandlordSubscription</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">landlordId: String</TD></TR><TR><TD ALIGN="LEFT">version: Int</TD></TR><TR><TD ALIGN="LEFT">planId: String</TD></TR><TR><TD ALIGN="LEFT">planSnapshot: Json</TD></TR></TABLE>>];
SubscriptionEvent [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>SubscriptionEvent</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">subscriptionId: String</TD></TR><TR><TD ALIGN="LEFT">actorId: String</TD></TR><TR><TD ALIGN="LEFT">action: String</TD></TR><TR><TD ALIGN="LEFT">snapshot: Json</TD></TR></TABLE>>];
Property -> User [dir=none,label="landlord",taillabel="0..*",headlabel="1",labeldistance=2.1];
LandlordVerification -> User [dir=none,label="landlord",taillabel="0..1",headlabel="1",labeldistance=2.1];
PropertyApprovalReview -> Property [dir=none,label="property",taillabel="0..1",headlabel="1",labeldistance=2.1];
LandlordSubscription -> User [dir=none,label="landlord",taillabel="0..1",headlabel="1",labeldistance=2.1];
LandlordSubscription -> ServicePlan [dir=none,label="plan",taillabel="0..*",headlabel="1",labeldistance=2.1];
SubscriptionEvent -> LandlordSubscription [dir=none,label="subscription",taillabel="0..*",headlabel="1",labeldistance=2.1];
}
digraph G {
graph [bgcolor="white",rankdir=LR,nodesep=0.35,ranksep=0.85,pad=0.15,splines=polyline];
node [fontname="Times New Roman", fontsize=17, color="black", fontcolor="black", style="filled", fillcolor="white", penwidth=1.1];
edge [fontname="Times New Roman", fontsize=14, color="black", arrowsize=0.7, penwidth=0.9];
Room [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>Room</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">status: RoomStatus</TD></TR><TR><TD ALIGN="LEFT">propertyId: String</TD></TR><TR><TD ALIGN="LEFT">name: String</TD></TR><TR><TD ALIGN="LEFT">floor: Int?</TD></TR></TABLE>>];
MaintenanceTicket [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>MaintenanceTicket</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">landlordId: String</TD></TR><TR><TD ALIGN="LEFT">roomId: String</TD></TR><TR><TD ALIGN="LEFT">status: MaintenanceStatus</TD></TR><TR><TD ALIGN="LEFT">propertyId: String</TD></TR></TABLE>>];
MaintenanceComment [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>MaintenanceComment</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">ticketId: String</TD></TR><TR><TD ALIGN="LEFT">authorId: String</TD></TR><TR><TD ALIGN="LEFT">authorRole: UserRole</TD></TR><TR><TD ALIGN="LEFT">body: String</TD></TR></TABLE>>];
Expense [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>Expense</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">landlordId: String</TD></TR><TR><TD ALIGN="LEFT">roomId: String?</TD></TR><TR><TD ALIGN="LEFT">amount: Int</TD></TR><TR><TD ALIGN="LEFT">propertyId: String</TD></TR></TABLE>>];
RoomTurnover [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>RoomTurnover</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">landlordId: String</TD></TR><TR><TD ALIGN="LEFT">roomId: String</TD></TR><TR><TD ALIGN="LEFT">leaseId: String?</TD></TR><TR><TD ALIGN="LEFT">status: TurnoverStatus</TD></TR></TABLE>>];
TurnoverStep [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>TurnoverStep</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">turnoverId: String</TD></TR><TR><TD ALIGN="LEFT">stage: TurnoverStage</TD></TR><TR><TD ALIGN="LEFT">title: String</TD></TR><TR><TD ALIGN="LEFT">completedAt: DateTime?</TD></TR></TABLE>>];
RecurringOperation [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>RecurringOperation</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">landlordId: String</TD></TR><TR><TD ALIGN="LEFT">roomId: String?</TD></TR><TR><TD ALIGN="LEFT">propertyId: String</TD></TR><TR><TD ALIGN="LEFT">title: String</TD></TR></TABLE>>];
OperationTask [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>OperationTask</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">landlordId: String</TD></TR><TR><TD ALIGN="LEFT">roomId: String?</TD></TR><TR><TD ALIGN="LEFT">status: OperationTaskStatus</TD></TR><TR><TD ALIGN="LEFT">version: Int</TD></TR></TABLE>>];
Expense -> Room [dir=none,label="room",taillabel="0..*",headlabel="0..1",labeldistance=2.1];
MaintenanceTicket -> Room [dir=none,label="room",taillabel="0..*",headlabel="1",labeldistance=2.1];
MaintenanceTicket -> Expense [dir=none,label="expense",taillabel="0..*",headlabel="0..1",labeldistance=2.1];
MaintenanceComment -> MaintenanceTicket [dir=none,label="ticket",taillabel="0..*",headlabel="1",labeldistance=2.1];
RoomTurnover -> Room [dir=none,label="room",taillabel="0..*",headlabel="1",labeldistance=2.1];
TurnoverStep -> RoomTurnover [dir=none,label="turnover",taillabel="0..*",headlabel="1",labeldistance=2.1];
RecurringOperation -> Room [dir=none,label="room",taillabel="0..*",headlabel="0..1",labeldistance=2.1];
OperationTask -> Room [dir=none,label="room",taillabel="0..*",headlabel="0..1",labeldistance=2.1];
OperationTask -> RecurringOperation [dir=none,label="recurring",taillabel="0..*",headlabel="1",labeldistance=2.1];
}
u4 [shape=ellipse,label="UC-OPT-04.1\nLưu trữ khu trọ",margin="0.12,0.08"];
u5 [shape=ellipse,label="UC-OPT-04.2\nKhôi phục khu trọ đã lưu trữ",margin="0.12,0.08"];
u6 [shape=ellipse,label="UC-OPT-04.3\nXóa khu trọ chưa có phòng",margin="0.12,0.08"];
}
actor0 -> u0 [arrowhead=none];
actor1 -> u0 [arrowhead=none];
actor0 -> u1 [arrowhead=none];
actor1 -> u1 [arrowhead=none];
actor0 -> u2 [arrowhead=none];
actor0 -> u3 [arrowhead=none];
actor1 -> u3 [arrowhead=none];
actor0 -> u4 [arrowhead=none];
actor1 -> u4 [arrowhead=none];
actor0 -> u5 [arrowhead=none];
actor1 -> u5 [arrowhead=none];
actor0 -> u6 [arrowhead=none];

digraph G {
graph [bgcolor="white",rankdir=LR,nodesep=0.35,ranksep=0.85,pad=0.15,splines=polyline];
node [fontname="Times New Roman", fontsize=17, color="black", fontcolor="black", style="filled", fillcolor="white", penwidth=1.1];
edge [fontname="Times New Roman", fontsize=14, color="black", arrowsize=0.7, penwidth=0.9];
Lease [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>Lease</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">tenantId: String</TD></TR><TR><TD ALIGN="LEFT">roomId: String</TD></TR><TR><TD ALIGN="LEFT">status: LeaseStatus</TD></TR><TR><TD ALIGN="LEFT">startDate: DateTime</TD></TR></TABLE>>];
Invoice [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>Invoice</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">tenantId: String</TD></TR><TR><TD ALIGN="LEFT">roomId: String</TD></TR><TR><TD ALIGN="LEFT">leaseId: String</TD></TR><TR><TD ALIGN="LEFT">status: InvoiceStatus</TD></TR></TABLE>>];
InvoiceLineItem [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>InvoiceLineItem</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">invoiceId: String</TD></TR><TR><TD ALIGN="LEFT">amount: Int</TD></TR><TR><TD ALIGN="LEFT">position: Int</TD></TR><TR><TD ALIGN="LEFT">kind: String</TD></TR></TABLE>>];
InvoiceAdjustment [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>InvoiceAdjustment</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">invoiceId: String</TD></TR><TR><TD ALIGN="LEFT">amount: Int</TD></TR><TR><TD ALIGN="LEFT">kind: String</TD></TR><TR><TD ALIGN="LEFT">category: String</TD></TR></TABLE>>];
MeterReading [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>MeterReading</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">roomId: String</TD></TR><TR><TD ALIGN="LEFT">amount: Int</TD></TR><TR><TD ALIGN="LEFT">billingMonth: DateTime</TD></TR><TR><TD ALIGN="LEFT">utilityType: UtilityType</TD></TR></TABLE>>];
BillingTariffVersion [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>BillingTariffVersion</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">landlordId: String</TD></TR><TR><TD ALIGN="LEFT">roomId: String?</TD></TR><TR><TD ALIGN="LEFT">amount: Int</TD></TR><TR><TD ALIGN="LEFT">version: Int</TD></TR></TABLE>>];
BillingPeriodLock [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>BillingPeriodLock</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">propertyId: String</TD></TR><TR><TD ALIGN="LEFT">month: DateTime</TD></TR><TR><TD ALIGN="LEFT">reason: String</TD></TR><TR><TD ALIGN="LEFT">actorId: String</TD></TR></TABLE>>];
InvoiceLineItem -> Invoice [dir=none,label="invoice",taillabel="0..*",headlabel="1",labeldistance=2.1];
Invoice -> Lease [dir=none,label="lease",taillabel="0..*",headlabel="1",labeldistance=2.1];
InvoiceAdjustment -> Invoice [dir=none,label="invoice",taillabel="0..*",headlabel="1",labeldistance=2.1];
}
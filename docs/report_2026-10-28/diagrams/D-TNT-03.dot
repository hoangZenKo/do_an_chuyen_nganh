digraph G {
graph [bgcolor="white", rankdir=LR, nodesep=0.30, ranksep=0.65, pad=0.2, splines=polyline];
node [fontname="Times New Roman", fontsize=17, color="black", fontcolor="black", style="filled", fillcolor="white", penwidth=1.1];
edge [fontname="Times New Roman", fontsize=14, color="black", arrowsize=0.7, penwidth=0.9];
actor0 [shape=box,label="«actor»\nChủ trọ"];
actor1 [shape=box,label="«actor»\nNgười thuê"];
actor2 [shape=box,label="«actor»\nStaff đúng quyền/scope"];
subgraph cluster_system { label="Rental Room Management · Hồ sơ người thuê và hợp đồng";fontname="Times New Roman";fontsize=18;color="black";
u0 [shape=ellipse,label="UC-TNT-10\nDuyệt yêu cầu gia hạn chuyển\nphòng trả phòng",margin="0.12,0.08"];
u1 [shape=ellipse,label="UC-TNT-11\nThực thi yêu cầu vòng đời đã\nđược duyệt",margin="0.12,0.08"];
u2 [shape=ellipse,label="UC-TNT-12.1\nQuản lý người ở cùng hợp đồng",margin="0.12,0.08"];
u3 [shape=ellipse,label="UC-TNT-12.2\nLập và xác nhận biên bản bàn\ngiao",margin="0.12,0.08"];
u4 [shape=ellipse,label="UC-TNT-13\nXuất và chia sẻ hợp đồng PDF",margin="0.12,0.08"];
}
actor0 -> u0 [arrowhead=none];
actor2 -> u0 [arrowhead=none];
actor0 -> u1 [arrowhead=none];
actor2 -> u1 [arrowhead=none];
actor0 -> u2 [arrowhead=none];
actor2 -> u2 [arrowhead=none];
actor0 -> u3 [arrowhead=none];
actor1 -> u3 [arrowhead=none];
actor0 -> u4 [arrowhead=none];
actor2 -> u4 [arrowhead=none];
}
digraph G {
graph [bgcolor="white", rankdir=LR, nodesep=0.30, ranksep=0.65, pad=0.2, splines=polyline];
node [fontname="Times New Roman", fontsize=17, color="black", fontcolor="black", style="filled", fillcolor="white", penwidth=1.1];
edge [fontname="Times New Roman", fontsize=14, color="black", arrowsize=0.7, penwidth=0.9];
actor0 [shape=box,label="«actor»\nNgười thuê"];
subgraph cluster_system { label="Rental Room Management · Cổng thông tin người thuê";fontname="Times New Roman";fontsize=18;color="black";
u0 [shape=ellipse,label="UC-TEN-01\nXem hồ sơ và tổng quan thuê\ncủa mình",margin="0.12,0.08"];
u1 [shape=ellipse,label="UC-TEN-02\nXem hợp đồng lịch sử cọc và\nquyết toán",margin="0.12,0.08"];
u2 [shape=ellipse,label="UC-TEN-03\nXem hóa đơn và chia sẻ PDF\ncủa mình",margin="0.12,0.08"];
u3 [shape=ellipse,label="UC-TEN-04\nTải tệp và gửi chứng từ thanh\ntoán",margin="0.12,0.08"];
u4 [shape=ellipse,label="UC-TEN-05\nThanh toán qua cổng thẻ mô\nphỏng",margin="0.12,0.08"];
u5 [shape=ellipse,label="UC-TEN-06\nGửi và phản hồi yêu cầu bảo\ntrì",margin="0.12,0.08"];
u6 [shape=ellipse,label="UC-TEN-07\nGửi hủy và theo dõi yêu cầu\nvòng đời thuê",margin="0.12,0.08"];
}
actor0 -> u0 [arrowhead=none];
actor0 -> u1 [arrowhead=none];
actor0 -> u2 [arrowhead=none];
actor0 -> u3 [arrowhead=none];
actor0 -> u4 [arrowhead=none];
actor0 -> u5 [arrowhead=none];
actor0 -> u6 [arrowhead=none];
}
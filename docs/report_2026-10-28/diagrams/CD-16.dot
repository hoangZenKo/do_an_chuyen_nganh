digraph G {
graph [bgcolor="white",rankdir=LR,nodesep=0.35,ranksep=0.85,pad=0.15,splines=polyline];
node [fontname="Times New Roman", fontsize=17, color="black", fontcolor="black", style="filled", fillcolor="white", penwidth=1.1];
edge [fontname="Times New Roman", fontsize=14, color="black", arrowsize=0.7, penwidth=0.9];
WorkerHeartbeat [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>WorkerHeartbeat</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">status: String</TD></TR><TR><TD ALIGN="LEFT">name: String</TD></TR><TR><TD ALIGN="LEFT">lastRunAt: DateTime</TD></TR><TR><TD ALIGN="LEFT">lastSuccessAt: DateTime?</TD></TR></TABLE>>];
OperationsMetric [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>OperationsMetric</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">minute: DateTime</TD></TR><TR><TD ALIGN="LEFT">requests: Int</TD></TR><TR><TD ALIGN="LEFT">errors: Int</TD></TR><TR><TD ALIGN="LEFT">loginFailures: Int</TD></TR><TR><TD ALIGN="LEFT">mfaFailures: Int</TD></TR></TABLE>>];
OperationsIncident [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>OperationsIncident</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">status: String</TD></TR><TR><TD ALIGN="LEFT">version: Int</TD></TR><TR><TD ALIGN="LEFT">ownerId: String?</TD></TR><TR><TD ALIGN="LEFT">conditionActive: Boolean</TD></TR></TABLE>>];
SupportTicket [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>SupportTicket</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">status: String</TD></TR><TR><TD ALIGN="LEFT">version: Int</TD></TR><TR><TD ALIGN="LEFT">slaSnapshot: Json?</TD></TR><TR><TD ALIGN="LEFT">slaPausedAt: DateTime?</TD></TR></TABLE>>];
SupportEscalation [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>SupportEscalation</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">ticketId: String</TD></TR><TR><TD ALIGN="LEFT">kind: String</TD></TR><TR><TD ALIGN="LEFT">deadlineAt: DateTime</TD></TR><TR><TD ALIGN="LEFT">level: Int</TD></TR></TABLE>>];
SupportCaseLink [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>SupportCaseLink</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">ticketId: String</TD></TR><TR><TD ALIGN="LEFT">kind: String</TD></TR><TR><TD ALIGN="LEFT">targetId: String</TD></TR><TR><TD ALIGN="LEFT">createdById: String</TD></TR></TABLE>>];
SlaEscalation [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>SlaEscalation</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">kind: String</TD></TR><TR><TD ALIGN="LEFT">targetId: String</TD></TR><TR><TD ALIGN="LEFT">dueAt: DateTime</TD></TR><TR><TD ALIGN="LEFT">createdAt: DateTime</TD></TR></TABLE>>];
SupportEscalation -> SupportTicket [dir=none,label="ticket",taillabel="0..*",headlabel="1",labeldistance=2.1];
SupportCaseLink -> SupportTicket [dir=none,label="ticket",taillabel="0..*",headlabel="1",labeldistance=2.1];
}
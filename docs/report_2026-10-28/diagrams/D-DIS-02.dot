digraph G {
graph [bgcolor="white", rankdir=LR, nodesep=0.30, ranksep=0.65, pad=0.2, splines=polyline];
node [fontname="Times New Roman", fontsize=17, color="black", fontcolor="black", style="filled", fillcolor="white", penwidth=1.1];
edge [fontname="Times New Roman", fontsize=14, color="black", arrowsize=0.7, penwidth=0.9];
actor0 [shape=box,label="«actor»\nChủ trọ"];
actor1 [shape=box,label="«actor»\nNgười thuê"];
actor2 [shape=box,label="«actor»\nNgười tìm phòng"];
subgraph cluster_system { label="Rental Room Management · Khám phá phòng và hành trình thuê";fontname="Times New Roman";fontsize=18;color="black";
u0 [shape=ellipse,label="UC-DIS-08\nQuản lý khung giờ xem phòng",margin="0.12,0.08"];
u1 [shape=ellipse,label="UC-DIS-09\nĐặt và theo dõi lịch xem\nphòng",margin="0.12,0.08"];
u2 [shape=ellipse,label="UC-DIS-10\nĐổi lịch hủy và xử lý lịch\nxem phòng",margin="0.12,0.08"];
u3 [shape=ellipse,label="UC-DIS-11\nChuyển lịch xem thành hợp\nđồng và bàn giao",margin="0.12,0.08"];
u4 [shape=ellipse,label="UC-DIS-12\nViết sửa và rút đánh giá theo\nhợp đồng",margin="0.12,0.08"];
u5 [shape=ellipse,label="UC-DIS-13\nChủ trọ trả lời đánh giá và\ngửi phản hồi thử nghiệm",margin="0.12,0.08"];
}
actor0 -> u0 [arrowhead=none];
actor2 -> u0 [arrowhead=none];
actor2 -> u1 [arrowhead=none];
actor0 -> u1 [arrowhead=none];
actor2 -> u2 [arrowhead=none];
actor0 -> u2 [arrowhead=none];
actor0 -> u3 [arrowhead=none];
actor1 -> u4 [arrowhead=none];
actor0 -> u5 [arrowhead=none];
actor1 -> u5 [arrowhead=none];
}
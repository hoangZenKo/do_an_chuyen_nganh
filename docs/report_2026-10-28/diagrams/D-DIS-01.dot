digraph G {
graph [bgcolor="white", rankdir=LR, nodesep=0.30, ranksep=0.65, pad=0.2, splines=polyline];
node [fontname="Times New Roman", fontsize=17, color="black", fontcolor="black", style="filled", fillcolor="white", penwidth=1.1];
edge [fontname="Times New Roman", fontsize=14, color="black", arrowsize=0.7, penwidth=0.9];
actor0 [shape=box,label="«actor»\nChủ trọ"];
actor1 [shape=box,label="«actor»\nNgười tìm phòng"];
actor2 [shape=box,label="«actor»\nNgười xem tin công\nkhai"];
subgraph cluster_system { label="Rental Room Management · Khám phá phòng và hành trình thuê";fontname="Times New Roman";fontsize=18;color="black";
u0 [shape=ellipse,label="UC-DIS-01\nTìm và lọc tin phòng công\nkhai",margin="0.12,0.08"];
u1 [shape=ellipse,label="UC-DIS-02\nXem chi tiết tin phòng và\nđánh giá công khai",margin="0.12,0.08"];
u2 [shape=ellipse,label="UC-DIS-03\nLưu và bỏ lưu phòng yêu thích",margin="0.12,0.08"];
u3 [shape=ellipse,label="UC-DIS-04\nLưu bộ lọc và xem cảnh báo\ntìm phòng",margin="0.12,0.08"];
u4 [shape=ellipse,label="UC-DIS-05\nTạo và cập nhật bản nháp tin\ncho thuê",margin="0.12,0.08"];
u5 [shape=ellipse,label="UC-DIS-06\nGửi duyệt và ẩn tin cho thuê",margin="0.12,0.08"];
u6 [shape=ellipse,label="UC-DIS-07\nBáo cáo tin phòng không phù\nhợp",margin="0.12,0.08"];
}
actor2 -> u0 [arrowhead=none];
actor2 -> u1 [arrowhead=none];
actor1 -> u2 [arrowhead=none];
actor1 -> u3 [arrowhead=none];
actor0 -> u4 [arrowhead=none];
actor0 -> u5 [arrowhead=none];
actor1 -> u6 [arrowhead=none];
}
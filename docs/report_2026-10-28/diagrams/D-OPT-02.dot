u5 [shape=ellipse,label="UC-OPT-07.3\nXóa phòng chưa phát sinh\nnghiệp vụ",margin="0.12,0.08"];
u6 [shape=ellipse,label="UC-OPT-08.1\nQuản lý tài sản phòng",margin="0.12,0.08"];
}
actor0 -> u0 [arrowhead=none];
actor1 -> u0 [arrowhead=none];

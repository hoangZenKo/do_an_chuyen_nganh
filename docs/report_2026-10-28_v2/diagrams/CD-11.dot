digraph G {
graph [bgcolor="white",rankdir=LR,nodesep=0.35,ranksep=0.85,pad=0.15,splines=polyline];
node [fontname="Times New Roman", fontsize=17, color="black", fontcolor="black", style="filled", fillcolor="white", penwidth=1.1];
edge [fontname="Times New Roman", fontsize=14, color="black", arrowsize=0.7, penwidth=0.9];
User [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>User</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">sessionVersion: Int</TD></TR><TR><TD ALIGN="LEFT">fullName: String</TD></TR><TR><TD ALIGN="LEFT">email: String</TD></TR><TR><TD ALIGN="LEFT">phone: String?</TD></TR></TABLE>>];
SupportTicket [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>SupportTicket</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">status: String</TD></TR><TR><TD ALIGN="LEFT">version: Int</TD></TR><TR><TD ALIGN="LEFT">slaSnapshot: Json?</TD></TR><TR><TD ALIGN="LEFT">slaPausedAt: DateTime?</TD></TR></TABLE>>];
SupportMessage [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>SupportMessage</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">ticketId: String</TD></TR><TR><TD ALIGN="LEFT">authorId: String?</TD></TR><TR><TD ALIGN="LEFT">authorRole: String</TD></TR><TR><TD ALIGN="LEFT">body: String</TD></TR></TABLE>>];
SupportAttachment [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>SupportAttachment</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">ticketId: String</TD></TR><TR><TD ALIGN="LEFT">filename: String</TD></TR><TR><TD ALIGN="LEFT">internal: Boolean</TD></TR><TR><TD ALIGN="LEFT">sha256: String</TD></TR></TABLE>>];
SupportSlaPolicy [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>SupportSlaPolicy</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">version: Int</TD></TR><TR><TD ALIGN="LEFT">enabled: Boolean</TD></TR><TR><TD ALIGN="LEFT">timezone: String</TD></TR><TR><TD ALIGN="LEFT">weekdays: Int[]</TD></TR></TABLE>>];
AdminReportSchedule [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>AdminReportSchedule</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">version: Int</TD></TR><TR><TD ALIGN="LEFT">timezone: String</TD></TR><TR><TD ALIGN="LEFT">ownerId: String</TD></TR><TR><TD ALIGN="LEFT">name: String</TD></TR></TABLE>>];
AdminReportRun [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>AdminReportRun</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">status: String</TD></TR><TR><TD ALIGN="LEFT">objectKey: String?</TD></TR><TR><TD ALIGN="LEFT">requestKey: String?</TD></TR><TR><TD ALIGN="LEFT">kind: String</TD></TR></TABLE>>];
PlatformNotification [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>PlatformNotification</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">userId: String</TD></TR><TR><TD ALIGN="LEFT">eventKey: String</TD></TR><TR><TD ALIGN="LEFT">kind: String</TD></TR><TR><TD ALIGN="LEFT">title: String</TD></TR></TABLE>>];
SupportTicket -> User [dir=none,label="requester",taillabel="0..*",headlabel="1",labeldistance=2.1];
SupportTicket -> User [dir=none,label="assignee",taillabel="0..*",headlabel="0..1",labeldistance=2.1];
SupportMessage -> SupportTicket [dir=none,label="ticket",taillabel="0..*",headlabel="1",labeldistance=2.1];
SupportMessage -> User [dir=none,label="author",taillabel="0..*",headlabel="0..1",labeldistance=2.1];
PlatformNotification -> User [dir=none,label="user",taillabel="0..*",headlabel="1",labeldistance=2.1];
AdminReportSchedule -> User [dir=none,label="owner",taillabel="0..*",headlabel="1",labeldistance=2.1];
AdminReportRun -> AdminReportSchedule [dir=none,label="schedule",taillabel="0..*",headlabel="1",labeldistance=2.1];
SupportAttachment -> SupportTicket [dir=none,label="ticket",taillabel="0..*",headlabel="1",labeldistance=2.1];
}
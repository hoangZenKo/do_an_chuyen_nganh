digraph G {
graph [bgcolor="white",rankdir=LR,nodesep=0.35,ranksep=0.85,pad=0.15,splines=polyline];
node [fontname="Times New Roman", fontsize=17, color="black", fontcolor="black", style="filled", fillcolor="white", penwidth=1.1];
edge [fontname="Times New Roman", fontsize=14, color="black", arrowsize=0.7, penwidth=0.9];
Tenant [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>Tenant</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">landlordId: String</TD></TR><TR><TD ALIGN="LEFT">userId: String?</TD></TR><TR><TD ALIGN="LEFT">fullName: String</TD></TR><TR><TD ALIGN="LEFT">phone: String?</TD></TR></TABLE>>];
Invoice [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>Invoice</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">tenantId: String</TD></TR><TR><TD ALIGN="LEFT">roomId: String</TD></TR><TR><TD ALIGN="LEFT">leaseId: String</TD></TR><TR><TD ALIGN="LEFT">status: InvoiceStatus</TD></TR></TABLE>>];
Payment [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>Payment</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">invoiceId: String</TD></TR><TR><TD ALIGN="LEFT">amount: Int</TD></TR><TR><TD ALIGN="LEFT">method: PaymentMethod</TD></TR><TR><TD ALIGN="LEFT">type: PaymentType</TD></TR></TABLE>>];
PaymentProof [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>PaymentProof</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">tenantId: String</TD></TR><TR><TD ALIGN="LEFT">invoiceId: String</TD></TR><TR><TD ALIGN="LEFT">status: PaymentProofStatus</TD></TR><TR><TD ALIGN="LEFT">amount: Int</TD></TR></TABLE>>];
BillingReceipt [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>BillingReceipt</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">landlordId: String</TD></TR><TR><TD ALIGN="LEFT">tenantId: String</TD></TR><TR><TD ALIGN="LEFT">amount: Int</TD></TR><TR><TD ALIGN="LEFT">availableAmount: Int</TD></TR></TABLE>>];
PaymentAllocation [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>PaymentAllocation</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">receiptId: String</TD></TR><TR><TD ALIGN="LEFT">amount: Int</TD></TR><TR><TD ALIGN="LEFT">paymentId: String</TD></TR><TR><TD ALIGN="LEFT">releasedAt: DateTime?</TD></TR></TABLE>>];
BillingRefund [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>BillingRefund</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">receiptId: String</TD></TR><TR><TD ALIGN="LEFT">amount: Int</TD></TR><TR><TD ALIGN="LEFT">reason: String</TD></TR><TR><TD ALIGN="LEFT">reference: String</TD></TR></TABLE>>];
BillingCommand [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>BillingCommand</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">landlordId: String</TD></TR><TR><TD ALIGN="LEFT">requestKey: String</TD></TR><TR><TD ALIGN="LEFT">requestHash: String</TD></TR><TR><TD ALIGN="LEFT">response: Json</TD></TR></TABLE>>];
Invoice -> Tenant [dir=none,label="tenant",taillabel="0..*",headlabel="1",labeldistance=2.1];
PaymentProof -> Invoice [dir=none,label="invoice",taillabel="0..*",headlabel="1",labeldistance=2.1];
PaymentProof -> Tenant [dir=none,label="tenant",taillabel="0..*",headlabel="1",labeldistance=2.1];
Payment -> Invoice [dir=none,label="invoice",taillabel="0..*",headlabel="1",labeldistance=2.1];
BillingReceipt -> Tenant [dir=none,label="tenant",taillabel="0..*",headlabel="1",labeldistance=2.1];
PaymentAllocation -> BillingReceipt [dir=none,label="receipt",taillabel="0..*",headlabel="1",labeldistance=2.1];
PaymentAllocation -> Payment [dir=none,label="payment",taillabel="0..1",headlabel="1",labeldistance=2.1];
BillingRefund -> BillingReceipt [dir=none,label="receipt",taillabel="0..*",headlabel="1",labeldistance=2.1];
}
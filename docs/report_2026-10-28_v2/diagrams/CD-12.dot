digraph G {
graph [bgcolor="white",rankdir=LR,nodesep=0.35,ranksep=0.85,pad=0.15,splines=polyline];
node [fontname="Times New Roman", fontsize=17, color="black", fontcolor="black", style="filled", fillcolor="white", penwidth=1.1];
edge [fontname="Times New Roman", fontsize=14, color="black", arrowsize=0.7, penwidth=0.9];
Lease [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>Lease</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">tenantId: String</TD></TR><TR><TD ALIGN="LEFT">roomId: String</TD></TR><TR><TD ALIGN="LEFT">status: LeaseStatus</TD></TR><TR><TD ALIGN="LEFT">startDate: DateTime</TD></TR></TABLE>>];
RoomReview [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>RoomReview</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">landlordId: String</TD></TR><TR><TD ALIGN="LEFT">roomId: String</TD></TR><TR><TD ALIGN="LEFT">leaseId: String</TD></TR><TR><TD ALIGN="LEFT">status: RoomReviewStatus</TD></TR></TABLE>>];
KnowledgeDocument [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>KnowledgeDocument</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">landlordId: String?</TD></TR><TR><TD ALIGN="LEFT">stableKey: String</TD></TR><TR><TD ALIGN="LEFT">title: String</TD></TR><TR><TD ALIGN="LEFT">scope: KnowledgeScope</TD></TR></TABLE>>];
KnowledgeChunk [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>KnowledgeChunk</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">documentId: String</TD></TR><TR><TD ALIGN="LEFT">ordinal: Int</TD></TR><TR><TD ALIGN="LEFT">heading: String</TD></TR><TR><TD ALIGN="LEFT">text: String</TD></TR></TABLE>>];
Invoice [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>Invoice</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">tenantId: String</TD></TR><TR><TD ALIGN="LEFT">roomId: String</TD></TR><TR><TD ALIGN="LEFT">leaseId: String</TD></TR><TR><TD ALIGN="LEFT">status: InvoiceStatus</TD></TR></TABLE>>];
PaymentLink [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>PaymentLink</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">landlordId: String</TD></TR><TR><TD ALIGN="LEFT">tenantId: String</TD></TR><TR><TD ALIGN="LEFT">invoiceId: String</TD></TR><TR><TD ALIGN="LEFT">status: PaymentLinkStatus</TD></TR></TABLE>>];
DemoCheckoutSession [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>DemoCheckoutSession</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">status: DemoCheckoutStatus</TD></TR><TR><TD ALIGN="LEFT">paymentLinkId: String</TD></TR><TR><TD ALIGN="LEFT">tokenHash: String</TD></TR><TR><TD ALIGN="LEFT">expiresAt: DateTime</TD></TR></TABLE>>];
PaymentWebhookEvent [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>PaymentWebhookEvent</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">landlordId: String</TD></TR><TR><TD ALIGN="LEFT">status: String</TD></TR><TR><TD ALIGN="LEFT">amount: Int</TD></TR><TR><TD ALIGN="LEFT">paymentLinkId: String</TD></TR></TABLE>>];
KnowledgeChunk -> KnowledgeDocument [dir=none,label="document",taillabel="0..*",headlabel="1",labeldistance=2.1];
RoomReview -> Lease [dir=none,label="lease",taillabel="0..1",headlabel="1",labeldistance=2.1];
Invoice -> Lease [dir=none,label="lease",taillabel="0..*",headlabel="1",labeldistance=2.1];
PaymentLink -> Invoice [dir=none,label="invoice",taillabel="0..*",headlabel="1",labeldistance=2.1];
DemoCheckoutSession -> PaymentLink [dir=none,label="paymentLink",taillabel="0..1",headlabel="1",labeldistance=2.1];
PaymentWebhookEvent -> PaymentLink [dir=none,label="paymentLink",taillabel="0..*",headlabel="1",labeldistance=2.1];
}
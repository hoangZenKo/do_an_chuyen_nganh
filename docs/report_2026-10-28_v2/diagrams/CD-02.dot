digraph G {
graph [bgcolor="white",rankdir=LR,nodesep=0.35,ranksep=0.85,pad=0.15,splines=polyline];
node [fontname="Times New Roman", fontsize=17, color="black", fontcolor="black", style="filled", fillcolor="white", penwidth=1.1];
edge [fontname="Times New Roman", fontsize=14, color="black", arrowsize=0.7, penwidth=0.9];
User [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>User</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">sessionVersion: Int</TD></TR><TR><TD ALIGN="LEFT">fullName: String</TD></TR><TR><TD ALIGN="LEFT">email: String</TD></TR><TR><TD ALIGN="LEFT">phone: String?</TD></TR></TABLE>>];
Property [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>Property</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">landlordId: String</TD></TR><TR><TD ALIGN="LEFT">name: String</TD></TR><TR><TD ALIGN="LEFT">address: String</TD></TR><TR><TD ALIGN="LEFT">isArchived: Boolean</TD></TR></TABLE>>];
Room [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>Room</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">status: RoomStatus</TD></TR><TR><TD ALIGN="LEFT">propertyId: String</TD></TR><TR><TD ALIGN="LEFT">name: String</TD></TR><TR><TD ALIGN="LEFT">floor: Int?</TD></TR></TABLE>>];
RoomAsset [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>RoomAsset</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">roomId: String</TD></TR><TR><TD ALIGN="LEFT">name: String</TD></TR><TR><TD ALIGN="LEFT">quantity: Int</TD></TR><TR><TD ALIGN="LEFT">condition: String</TD></TR></TABLE>>];
RoomInspection [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>RoomInspection</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">roomId: String</TD></TR><TR><TD ALIGN="LEFT">title: String</TD></TR><TR><TD ALIGN="LEFT">dueAt: DateTime</TD></TR><TR><TD ALIGN="LEFT">completedAt: DateTime?</TD></TR></TABLE>>];
RoomServiceFee [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>RoomServiceFee</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">roomId: String</TD></TR><TR><TD ALIGN="LEFT">amount: Int</TD></TR><TR><TD ALIGN="LEFT">name: String</TD></TR><TR><TD ALIGN="LEFT">isActive: Boolean</TD></TR></TABLE>>];
ServiceTariffVersion [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>ServiceTariffVersion</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">amount: Int</TD></TR><TR><TD ALIGN="LEFT">version: Int</TD></TR><TR><TD ALIGN="LEFT">serviceFeeId: String</TD></TR><TR><TD ALIGN="LEFT">name: String</TD></TR></TABLE>>];
Property -> User [dir=none,label="landlord",taillabel="0..*",headlabel="1",labeldistance=2.1];
Room -> Property [dir=none,label="property",taillabel="0..*",headlabel="1",labeldistance=2.1];
RoomAsset -> Room [dir=none,label="room",taillabel="0..*",headlabel="1",labeldistance=2.1];
RoomInspection -> Room [dir=none,label="room",taillabel="0..*",headlabel="1",labeldistance=2.1];
RoomServiceFee -> Room [dir=none,label="room",taillabel="0..*",headlabel="1",labeldistance=2.1];
ServiceTariffVersion -> RoomServiceFee [dir=none,label="serviceFee",taillabel="0..*",headlabel="1",labeldistance=2.1];
}
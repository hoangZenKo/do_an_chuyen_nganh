digraph G {
graph [bgcolor="white",rankdir=LR,nodesep=0.35,ranksep=0.85,pad=0.15,splines=polyline];
node [fontname="Times New Roman", fontsize=17, color="black", fontcolor="black", style="filled", fillcolor="white", penwidth=1.1];
edge [fontname="Times New Roman", fontsize=14, color="black", arrowsize=0.7, penwidth=0.9];
User [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>User</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">sessionVersion: Int</TD></TR><TR><TD ALIGN="LEFT">fullName: String</TD></TR><TR><TD ALIGN="LEFT">email: String</TD></TR><TR><TD ALIGN="LEFT">phone: String?</TD></TR></TABLE>>];
ModerationPolicy [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>ModerationPolicy</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">status: String</TD></TR><TR><TD ALIGN="LEFT">version: Int</TD></TR><TR><TD ALIGN="LEFT">kind: String</TD></TR><TR><TD ALIGN="LEFT">title: String</TD></TR></TABLE>>];
SupportTemplate [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>SupportTemplate</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">version: Int</TD></TR><TR><TD ALIGN="LEFT">title: String</TD></TR><TR><TD ALIGN="LEFT">body: String</TD></TR><TR><TD ALIGN="LEFT">isActive: Boolean</TD></TR></TABLE>>];
SupportSavedView [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>SupportSavedView</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">version: Int</TD></TR><TR><TD ALIGN="LEFT">ownerId: String</TD></TR><TR><TD ALIGN="LEFT">name: String</TD></TR><TR><TD ALIGN="LEFT">filters: Json</TD></TR></TABLE>>];
SupportAgentSkill [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>SupportAgentSkill</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">userId: String</TD></TR><TR><TD ALIGN="LEFT">category: String</TD></TR><TR><TD ALIGN="LEFT">maxOpen: Int</TD></TR></TABLE>>];
PlatformNotificationPreference [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>PlatformNotificationPreference</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">userId: String</TD></TR><TR><TD ALIGN="LEFT">email: Boolean</TD></TR><TR><TD ALIGN="LEFT">push: Boolean</TD></TR><TR><TD ALIGN="LEFT">updatedAt: DateTime</TD></TR></TABLE>>];
PlatformNotificationDelivery [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>PlatformNotificationDelivery</B></TD></TR><TR><TD BORDER="1" SIDES="T"></TD></TR><TR><TD ALIGN="LEFT">id: String</TD></TR><TR><TD ALIGN="LEFT">status: String</TD></TR><TR><TD ALIGN="LEFT">notificationId: String</TD></TR><TR><TD ALIGN="LEFT">channel: String</TD></TR><TR><TD ALIGN="LEFT">attempts: Int</TD></TR></TABLE>>];
SupportSavedView -> User [dir=none,label="owner",taillabel="0..*",headlabel="1",labeldistance=2.1];
SupportAgentSkill -> User [dir=none,label="user",taillabel="0..*",headlabel="1",labeldistance=2.1];
PlatformNotificationPreference -> User [dir=none,label="user",taillabel="0..1",headlabel="1",labeldistance=2.1];
}
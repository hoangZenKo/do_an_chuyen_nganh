{
  "name": "rental-room-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "prestart:dev": "npm run ops:readiness",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main",
    "prestart:prod": "node dist/scripts/schema-readiness.js",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:e2e": "NODE_ENV=test jest --config ./test/jest-e2e.json --runInBand",
    "test:admin-accounts:e2e": "node --env-file=.env scripts/run-admin-accounts-e2e.mjs",
    "test:admin-accounts:safety": "node --test scripts/run-admin-accounts-e2e.test.mjs",
    "test:manual-transfers:e2e": "node --env-file=.env scripts/run-manual-transfers-e2e.mjs",
    "test:admin-inventory:e2e": "node --env-file=.env scripts/run-admin-accounts-e2e.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "admin:bootstrap": "tsx prisma/bootstrap-admin.ts",
    "demo:prepare": "tsx prisma/prepare-demo-payments.ts",
    "knowledge:import": "tsx scripts/import-knowledge.ts",
    "knowledge:revoke": "tsx scripts/revoke-knowledge.ts",
    "knowledge:evaluate": "tsx scripts/evaluate-knowledge.ts",
    "chatbot:evaluate": "tsx scripts/evaluate-chatbot.ts",
    "ops:backup": "node --env-file=.env scripts/database-safety.mjs backup",
    "ops:backup-worker": "node --env-file=.env scripts/backup-worker.mjs",
    "ops:restore-check": "node --env-file=.env scripts/database-safety.mjs restore-check",
    "ops:rehearse": "node --env-file=.env scripts/database-safety.mjs rehearse",
    "ops:preflight": "node --env-file=.env scripts/database-safety.mjs preflight",
    "ops:admin-preflight": "node --env-file=.env --import tsx scripts/admin-release-preflight.ts",
    "ops:readiness": "tsx scripts/schema-readiness.ts",
    "ops:schema-drift": "prisma migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --exit-code",
    "ops:migrate": "node --env-file=.env scripts/database-safety.mjs migrate",
    "ops:smoke": "node --env-file=.env scripts/staging-admin-smoke.mjs",
    "ops:billing-rehearse": "node --env-file=.env scripts/run-billing-production-e2e.mjs",
    "ops:provider-smoke": "node --env-file=.env scripts/provider-smoke.mjs",
    "test:safety-scripts": "node --test scripts/database-safety.test.mjs scripts/offsite-backup.test.mjs scripts/provider-smoke.test.mjs scripts/backup-telemetry.test.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/throttler": "^6.2.1",
    "@prisma/client": "^6.2.1",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.5",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prisma": "^6.2.1",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}

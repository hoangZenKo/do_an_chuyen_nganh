@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam dpi 240
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 17
skinparam defaultFontColor black
skinparam titleFontSize 21
skinparam titleFontColor black
skinparam roundcorner 0
skinparam maxMessageSize 270
skinparam ParticipantPadding 30
skinparam sequence {
  ArrowColor #800000
  ArrowThickness 1.2
  LifeLineBorderColor #999999
  LifeLineBackgroundColor #FFFFB9
  ParticipantBackgroundColor #FFFFB9
  ParticipantBorderColor #800000
  ParticipantFontColor black
  ActorBackgroundColor #FFFFB9
  ActorBorderColor #800000
  ActorFontColor black
  BoundaryBackgroundColor #FFFFB9
  BoundaryBorderColor #800000
  ControlBackgroundColor #FFFFB9
  ControlBorderColor #800000
  EntityBackgroundColor #FFFFB9
  EntityBorderColor #800000
  GroupBackgroundColor #FFFFB9
  GroupBodyBackgroundColor white
  GroupBorderColor #888888
  GroupFontColor black
  GroupHeaderFontColor black
  GroupFontSize 15
  GroupHeaderFontSize 16
  MessageAlign center
}
hide footbox
<style>
sequenceDiagram {
 actor { BackgroundColor #FFFFB9
 LineColor #800000 }
 boundary { BackgroundColor #FFFFB9
 LineColor #800000 }
 control { BackgroundColor #FFFFB9
 LineColor #800000 }
 entity { BackgroundColor #FFFFB9
 LineColor #800000 }
 activationBox { BackgroundColor #FFFFB9
 LineColor #800000 }
}
</style>
autonumber "<b>0.</b>"

title SD-12. Tiếp nhận và hoàn tất yêu cầu bảo trì
actor "Người thuê" as A
actor "Chủ trọ /\nnhân viên được phân quyền" as B
boundary "<u>Giao diện</u>\n<u>bảo trì</u>" as U #FFFFB9
control "<u>Quản lý</u>\n<u>bảo trì</u>" as C #FFFFB9
entity "<u>Phiếu bảo trì</u>\n<u>và chi phí sửa chữa</u>" as D #FFFFB9
A -> U: Gửi sự cố của phòng đang thuê và thông tin mô tả
activate U
U -> C: Yêu cầu tiếp nhận sự cố bảo trì
activate C
C -> D ++: Đối chiếu phòng đang thuê; lưu yêu cầu hợp lệ
D --> C --: Phiếu mới hoặc lý do không tiếp nhận
C --> U: Hiển thị kết quả gửi yêu cầu bảo trì
U --> A: Hiển thị kết quả gửi yêu cầu bảo trì
deactivate C
deactivate U
opt Có phiếu thuộc quyền quản lý; chọn phân công
B -> U: Phân công người xử lý và cập nhật tiến độ
activate U
U -> C: Yêu cầu cập nhật xử lý bảo trì
activate C
C -> D ++: Đối chiếu người phụ trách và quyền; lưu thay đổi hợp lệ
D --> C --: Phiếu và lịch sử xử lý được cập nhật hoặc báo lỗi
C --> U: Hiển thị kết quả cập nhật phiếu
U --> B: Hiển thị kết quả cập nhật phiếu
deactivate C
deactivate U
end
loop Mỗi lần một bên có quyền gửi trao đổi cho phiếu
alt Người thuê gửi trao đổi
A -> U: Gửi nội dung trao đổi về phiếu
activate U
U -> C: Gửi nội dung trao đổi về phiếu
activate C
C -> D ++: Đối chiếu quyền xem phiếu; lưu trao đổi hợp lệ
D --> C --: Nội dung đã lưu hoặc lý do từ chối
C --> U: Hiển thị kết quả gửi trao đổi
U --> A: Hiển thị kết quả gửi trao đổi
deactivate C
deactivate U
else Chủ trọ hoặc nhân viên có quyền gửi trao đổi
B -> U: Gửi nội dung trao đổi về phiếu
activate U
U -> C: Gửi nội dung trao đổi về phiếu
activate C
C -> D ++: Đối chiếu quyền xử lý phiếu; lưu trao đổi hợp lệ
D --> C --: Nội dung đã lưu hoặc lý do từ chối
C --> U: Hiển thị kết quả gửi trao đổi
U --> B: Hiển thị kết quả gửi trao đổi
deactivate C
deactivate U
end
end
opt Người có quyền hoàn tất chọn kết thúc sửa chữa
B -> U: Xác nhận hoàn tất; nhập chi phí và chọn ghi chi nếu cần
activate U
U -> C: Yêu cầu hoàn tất phiếu bảo trì
activate C
C -> D ++: Đối chiếu trạng thái phiếu và chi phí đã liên kết
D --> C --: Tình trạng phiếu và khoản chi đã có
alt Phiếu đã hủy hoặc thay đổi chi phí đã gắn khoản chi
C --> U: Không hoàn tất
U --> B: Không hoàn tất; thông báo lý do
else Phiếu đủ điều kiện hoàn tất
opt Chọn ghi chi; chi phí lớn hơn 0; chưa có khoản chi liên kết
C -> D ++: Lập khoản chi sửa chữa và liên kết phiếu
D --> C --: Khoản chi được tạo một lần
end
C -> D ++: Ghi phiếu đã hoàn tất và chi phí thực tế
D --> C --: Phiếu được cập nhật
C --> U: Hiển thị phiếu hoàn tất và khoản chi nếu có
U --> B: Hiển thị phiếu hoàn tất và khoản chi nếu có
end
deactivate C
deactivate U
end
@enduml

@startuml
left to right direction
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam backgroundColor #F8FAFC
skinparam shadowing false
skinparam ArrowColor #52647A
skinparam ArrowThickness 1
skinparam actorStyle stickman
skinparam actorBorderColor #243A52
skinparam actorFontColor #243A52
skinparam actorBackgroundColor #FFFFFF
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #327C83
  FontColor #20354B
  BackgroundColor<<Một phần>> #FFF0CE
  BorderColor<<Một phần>> #B17917
  BackgroundColor<<DEMO>> #FCE5DF
  BorderColor<<DEMO>> #BC593A
  BackgroundColor<<MÔ PHỎNG>> #E7EAF1
  BorderColor<<MÔ PHỎNG>> #6C7488
}
skinparam rectangle {
  BackgroundColor #EEF4F5
  BorderColor #243A52
  FontColor #243A52
}
skinparam titleFontColor #20354B
skinparam titleFontSize 18
skinparam nodesep 25
skinparam ranksep 65
title G04 Khu trọ và cơ sở vật chất phần 1

actor "A02\nChủ trọ" as A02
actor "A03\nNhân viên vận hành" as A03
rectangle "Hệ thống quản lý nhà trọ" as SYSTEM {
  usecase "UC-OPT-02\nTra cứu khu trọ" as UC_OPT_02
  usecase "UC-OPT-03.1\nTạo khu trọ" as UC_OPT_03_1
  usecase "UC-OPT-03.2\nCập nhật thông tin khu trọ" as UC_OPT_03_2
  usecase "UC-OPT-04.1\nLưu trữ hoặc khôi phục khu trọ" as UC_OPT_04_1
  usecase "UC-OPT-04.3\nXóa khu trọ đủ điều kiện" as UC_OPT_04_3
  usecase "UC-OPT-05\nTra cứu phòng và lịch sử liên\nquan" as UC_OPT_05
  usecase "UC-OPT-06.1\nTạo phòng" as UC_OPT_06_1
}
A02 -- UC_OPT_02
UC_OPT_02 -- A03
A02 -- UC_OPT_03_1
A02 -- UC_OPT_03_2
UC_OPT_03_2 -- A03
A02 -- UC_OPT_04_1
UC_OPT_04_1 -- A03
A02 -- UC_OPT_04_3
UC_OPT_04_3 -- A03
A02 -- UC_OPT_05
UC_OPT_05 -- A03
A02 -- UC_OPT_06_1
UC_OPT_06_1 -- A03
legend bottom left
  Đường liền: tác nhân tham gia mục tiêu nghiệp vụ.
  Đường xanh có nhãn: chỉ tham gia trong phạm vi giới hạn được nêu.
  Nhân viên cần quyền phù hợp và khu được giao; quản trị viên cần đúng thẩm quyền.
  Vàng: đáp ứng một phần. Cam: thanh toán thử nghiệm. Xám: trao đổi mô phỏng.
  Không thể hiện thứ tự thực hiện; không suy ra quyền từ vị trí tác nhân.
endlegend
@enduml
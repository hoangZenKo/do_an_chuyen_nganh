  usecase "UC-BIL-18.3\nTheo dõi và gửi lại thông báo\nhóa đơn" as UC_BIL_18_3
  usecase "UC-TEN-08.2\nChọn kênh nhận nhắc nợ" as UC_TEN_08_2
}
actor "E01\nĐơn vị gửi thư\nhoặc thông báo\n(có điều kiện)" as E01
actor "E02\nNhà cung cấp Zalo ZNS\n(có điều kiện)" as E02

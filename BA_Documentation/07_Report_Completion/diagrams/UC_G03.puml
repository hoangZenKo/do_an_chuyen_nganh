@startuml
left to right direction
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam backgroundColor #F8FAFC
skinparam shadowing false
skinparam ArrowColor #52647A
skinparam ArrowThickness 1
skinparam actorStyle stickman
skinparam actorBorderColor #243A52
skinparam actorFontColor #243A52
skinparam actorBackgroundColor #FFFFFF
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #327C83
  FontColor #20354B
  BackgroundColor<<Một phần>> #FFF0CE
  BorderColor<<Một phần>> #B17917
  BackgroundColor<<DEMO>> #FCE5DF
  BorderColor<<DEMO>> #BC593A
  BackgroundColor<<MÔ PHỎNG>> #E7EAF1
  BorderColor<<MÔ PHỎNG>> #6C7488
}
skinparam rectangle {
  BackgroundColor #EEF4F5
  BorderColor #243A52
  FontColor #243A52
}
skinparam titleFontColor #20354B
skinparam titleFontSize 18
skinparam nodesep 25
skinparam ranksep 65
title G03 · Đăng tin, lịch xem và nhận phòng\n<size:12>Đầy đủ UC của nhóm nghiệp vụ</size>

actor "A02\nChủ trọ" as A02
actor "A04\nNgười tìm phòng\nhoặc người thuê" as A04
rectangle "Hệ thống quản lý nhà trọ" as SYSTEM {
  usecase "UC-DIS-05\nQuản lý và gửi duyệt tin cho\nthuê" as UC_DIS_05
  usecase "UC-DIS-06.2\nẨn tin cho thuê của mình" as UC_DIS_06_2
  usecase "UC-DIS-08\nQuản lý khung giờ xem phòng" as UC_DIS_08
  usecase "UC-DIS-09\nĐặt và quản lý lịch xem của mình" as UC_DIS_09
  usecase "UC-DIS-10\nTiếp nhận và hoàn tất lịch xem" as UC_DIS_10
  usecase "UC-TNT-12.2\nLập biên bản bàn giao nhận phòng" as UC_TNT_12_2
  usecase "UC-TNT-12.3\nXác nhận biên bản bàn giao nhận\nphòng" as UC_TNT_12_3
}
A02 -- UC_DIS_05
A02 -- UC_DIS_06_2
A02 -- UC_DIS_08
A04 -[#3975AA]- UC_DIS_08 : chỉ xem khung giờ
A04 -- UC_DIS_09
A02 -- UC_DIS_10
A02 -- UC_TNT_12_2
A04 -[#3975AA]- UC_TNT_12_2 : chỉ xem biên bản
A04 -- UC_TNT_12_3
legend bottom left
  Đường liền: tác nhân tham gia mục tiêu nghiệp vụ.
  Đường xanh có nhãn: chỉ tham gia trong phạm vi giới hạn được nêu.
  Nhân viên cần quyền phù hợp và khu được giao; quản trị viên cần đúng thẩm quyền.
  Vàng: đáp ứng một phần. Cam: thanh toán thử nghiệm. Xám: trao đổi mô phỏng.
  Không thể hiện thứ tự thực hiện; không suy ra quyền từ vị trí tác nhân.
endlegend
@enduml

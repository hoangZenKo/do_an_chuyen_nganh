@startuml
left to right direction
skinparam defaultFontName SansSerif
skinparam defaultFontSize 16
skinparam dpi 250
skinparam monochrome true
skinparam backgroundColor white
skinparam shadowing false
skinparam ArrowColor black
skinparam ArrowThickness 1.3
skinparam actorStyle stickman
skinparam actorBorderColor black
skinparam actorFontColor black
skinparam actorBackgroundColor white
skinparam usecase {
  BackgroundColor white
  BorderColor black
  FontColor black
  BorderThickness 1.3
}
skinparam rectangle {
  BackgroundColor white
  BorderColor black
  FontColor black
  FontSize 18
  FontStyle bold
  BorderThickness 1.3
}
skinparam titleFontColor black
skinparam titleFontSize 19
skinparam nodesep 30
skinparam ranksep 75
skinparam padding 12
skinparam linetype polyline
title G05 - Nhân sự và ủy quyền vận hành

actor "**A02**\nChủ trọ" as A02
actor "**A03**\nNhân viên vận hành" as A03
rectangle "Hệ thống quản lý nhà trọ" as SYSTEM {
  usecase "**UC-STF-01**\nMời nhân viên và cấp phạm vi khu\ntrọ" as UC_STF_01
  usecase "**UC-STF-02**\nCập nhật quyền trạng thái và\nphạm vi nhân viên" as UC_STF_02
  usecase "**UC-STF-04**\nTra cứu nhân viên và phạm vi\nđược cấp" as UC_STF_04
  usecase "**UC-STF-03**\nMô phỏng quyền nhân viên" as UC_STF_03
  UC_STF_01 -[hidden]right- UC_STF_02
  UC_STF_02 -[hidden]right- UC_STF_04
  UC_STF_04 -[hidden]right- UC_STF_03
}
A02 -- UC_STF_01
UC_STF_01 -- A03 : chỉ xem nhân viên và bộ quyền mẫu
A02 -- UC_STF_02
A02 -- UC_STF_04
UC_STF_04 -- A03
A02 -- UC_STF_03
legend bottom left
  Nhân viên thực hiện trong quyền và phạm vi khu trọ được giao.
endlegend
@enduml
